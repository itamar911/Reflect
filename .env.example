# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — server-only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API — every route under src/app/api/ai-*
ANTHROPIC_API_KEY=

# Resend — transactional email and alerts
RESEND_API_KEY=

# Shared secret checked by /api/cron/send-alerts
CRON_SECRET=

# Tradovate — application session (password grant, src/lib/tradovate/config.ts)
# Demo: https://demo.tradovateapi.com/v1   Live: https://live.tradovateapi.com/v1
TRADOVATE_API_URL=
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=
# Numeric — Tradovate rejects this as a string
TRADOVATE_CID=
TRADOVATE_SEC=
TRADOVATE_DEVICE_ID=

# Tradovate OAuth — connecting a user's account to read their executions
# Verify this block with: npm run tradovate:check
#
# TRADOVATE_API_URL above is part of this set too: it selects the environment
# (demo or live), which decides the authorize and token hosts and is recorded
# on every stored connection.
TRADOVATE_OAUTH_CLIENT_ID=
TRADOVATE_OAUTH_CLIENT_SECRET=
# Must match the URI registered with Tradovate byte for byte. Registered:
# https://reflecttrading.app/api/tradovate/callback
TRADOVATE_OAUTH_REDIRECT_URI=
# 32 bytes. Generate it yourself — see the Tradovate section of README.md.
# If this key ever changes, every stored token becomes undecryptable and every
# connected user must reconnect.
TRADOVATE_TOKEN_ENCRYPTION_KEY=

# Who may use the Tradovate connection. Comma-separated Supabase user ids.
#
# LEAVE IT EMPTY. Empty or unset means EVERY signed-in user may connect, which
# is the launched state. A non-empty value restricts the connection to exactly
# the ids it names, so this is the rollback lever: paste one id in to close the
# connection again, clear it to reopen. One environment change either way, no
# deploy and no code revert.
#
# It used to fail closed — unset meant nobody, including you — which was right
# while the production OAuth path was untested. See the header of
# src/lib/tradovate/allowlist.ts for why that inverted.
#
# Enforced server-side at TEN places and not two, which is what the comment
# here used to claim: /api/tradovate/connect, /callback, /today, /trades,
# /sync, /live, the import, orders and keep-alive crons, and the
# import-before-email step of /api/cron/send-alerts. Six server-rendered UI
# gates follow it and are cosmetic — a hidden button is still a URL. All
# sixteen read isUserAllowed(); none has its own copy of the rule.
#
# TRADOVATE_IMPORT_ENABLED is the OTHER lever and is not a substitute: it
# silences every pull and import but does NOT stop new users connecting.
TRADOVATE_OAUTH_ALLOWED_USER_IDS=

# Optional overrides, only for a Tradovate environment src/lib/tradovate/hosts.ts
# does not know about. Left unset, the authorize and token URLs are looked up
# per environment from the documented values — do NOT derive one host from
# another, which is what this used to do and why Demo was wrong.
# TRADOVATE_OAUTH_AUTHORIZE_URL=
# TRADOVATE_OAUTH_TOKEN_URL=

# Local tooling only, not deployment config. scripts/capture-phone-demo.mjs
# defaults to http://localhost:3000/demo/phone-showcase when unset.
# CAPTURE_URL=

# Local tooling only. scripts/repro-upload.mjs signs in as this user. Read from
# this file and never from the command line -- an approved command is saved
# verbatim, credentials included.
# SUPABASE_TEST_EMAIL=
# SUPABASE_TEST_PASSWORD=
