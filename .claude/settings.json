{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(git reset --hard *)",
      "Bash(git * --hard *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git * --hard *)",
      "Bash(rm *)",
      "PowerShell(rm *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(del *)",
      "PowerShell(ri *)",
      "PowerShell(rd *)",
      "Bash(supabase *)",
      "Bash(npx supabase *)",
      "PowerShell(supabase *)",
      "PowerShell(npx supabase *)",
      "Bash(psql *)",
      "PowerShell(psql *)",
      "Bash(*supabase.co*)",
      "PowerShell(*supabase.co*)",
      "Bash(*node *probe-bucket*)",
      "PowerShell(*node *probe-bucket*)",
      "Bash(*node *cleanup-orphans*)",
      "PowerShell(*node *cleanup-orphans*)",
      "Bash(*node *repro-upload*)",
      "PowerShell(*node *repro-upload*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.test)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.*.local)",
      "Edit(.env.development)",
      "Edit(.env.production)",
      "Edit(.env.test)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)"
    ],
    "allow": [
      "Read(.env.example)",
      "Edit(.env.example)"
    ]
  }
}
