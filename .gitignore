# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the credential template, which holds only empty variable names.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# Claude Code config. settings.json (shared project rules) and skills are
# committed; settings.local.json (personal, machine-specific) is not.
# **/ so nested .claude/ dirs (e.g. supabase/.claude/) can't get tracked either
**/.claude/*
!.claude/skills/
!.claude/settings.json

# Tradovate spike: local credentials and raw API dumps
scripts/spike/.env
scripts/spike/out/
